# One public address. Caddy gets the HTTPS certificate by itself when SITE_ADDRESS is a real domain.
# For a local test use SITE_ADDRESS=http://localhost (plain HTTP).
{$SITE_ADDRESS} {
	encode gzip

	# One JSON line per request on stdout. deploy/azure/idle-shutdown.sh reads it to tell whether anyone is using the site.
	log {
		output stdout
		format json
	}

	header {
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=31536000"
		-Server
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}

	# The site and its APIs share one address. The APIs check the login token themselves.
	handle_path /api/billing/* {
		reverse_proxy billing-service:8080
	}
	handle_path /api/report/* {
		reverse_proxy report-service:8000
	}
	handle_path /api/notification/* {
		reverse_proxy notification-service:3000
	}

	# Tools that show the architecture (Kafka messages, the fake inbox). They display the data of EVERY company,
	# so they are for the owner only, behind a separate password that is never published.
	handle /kafka* {
		basicauth {
			{$BASIC_USER} {$BASIC_HASH}
		}
		reverse_proxy kafka-ui:8080
	}
	handle /mail* {
		basicauth {
			{$BASIC_USER} {$BASIC_HASH}
		}
		reverse_proxy mailpit:8025
	}

	handle {
		reverse_proxy dashboard:80
	}

	# Kafka UI is switched off by default to save memory (see docker-compose.prod.yml). Say so instead of a bare 502.
	handle_errors {
		# only when the proxy itself fails (Kafka UI is off); a wrong password must still get the 401 login prompt
		@kafkaDown expression `path('/kafka*') && {http.error.status_code} >= 502`
		respond @kafkaDown "Kafka UI is off to save memory. The owner can turn it on with: docker compose --profile tools up -d kafka-ui" 503
	}
}
