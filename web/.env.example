# Copy to .env.local and fill in (Supabase: Project Settings -> API). Both values are public by design:
# the anon/publishable key is safe in the browser because every table is protected by row level security.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
